{
  "name": "trauma-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TraumaCompass — CPTSD/BPD 就诊资源与就诊线索地图（静态站点）",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "test:map-wheel": "node --test tests/map-wheel-zoom.test.mjs",
    "test:map-layout": "node --test tests/map-layout.test.mjs tests/sheet-drag.test.mjs",
    "test:geo": "node --test tests/amap-geocode.test.mjs",
    "prebuild": "node scripts/validate-data.ts && node scripts/build-aggregates.ts",
    "geo:fetch": "node scripts/fetch-geo.ts",
    "geo:geocode": "node scripts/geocode-hospitals.ts --missing --write",
    "provinces:build": "node scripts/build-provinces.ts",
    "data:validate": "node scripts/validate-data.ts",
    "data:build": "node scripts/build-aggregates.ts",
    "data:stats": "node scripts/data-stats.ts",
    "data:import": "node scripts/import-kdocs.ts",
    "test:data": "node --test tests/data-source.test.mjs",
    "test:search": "node --test tests/search-disorder-label.test.mjs",
    "test:amap": "node --test tests/map-coordinates.test.mjs tests/preview.test.mjs"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@gsap/react": "^2.1.2",
    "@next/env": "16.3.4",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3"
  }
}
